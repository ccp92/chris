---
import CommentsIsland from "./Comments.tsx";

interface Props {
  bskyPostUri: string;
}

const { bskyPostUri } = Astro.props;
---

<div class="comments-section">
  <h3>Comments</h3>
  <CommentsIsland client:visible bskyPostUri={bskyPostUri} />
</div>

<style>
  .comments-section {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 2px solid hsl(153, 39%, 41%);
  }
  .comments-section h3 {
    color: hsl(155, 43%, 18%);
    margin-bottom: 1rem;
  }
  .comment {
    margin-bottom: 1rem;
    padding: 0.75rem;
    background: #f8f9fa;
    border-radius: 4px;
  }
  .comment-author {
    font-weight: bold;
    color: hsl(153, 40%, 30%);
    font-size: 0.95rem;
  }
  .comment-text {
    margin-top: 0.25rem;
    font-size: 1rem;
    line-height: 1.4;
  }
  .comment-time {
    font-size: 0.8rem;
    color: #666;
    margin-top: 0.25rem;
  }
  .no-comments {
    color: #666;
    font-style: italic;
  }
  .comments-loading {
    color: #666;
  }
  .reply-link {
    margin-top: 1rem;
    font-size: 0.9rem;
  }
  .reply-link a {
    color: hsl(153, 39%, 41%);
  }
</style>
