---
import { getCollection, getEntry, render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import Comments from "../../components/Comments.astro";
import fs from "fs";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post: (typeof posts)[number]) => ({
    params: { post: post.id },
  }));
}

const { post } = Astro.params;
if (!post) throw new Error("Missing post param");

const entry = await getEntry("blog", post);
if (!entry) return Astro.redirect("/404");

const { Content } = await render(entry);

let documentUri: string | undefined;
try {
  const syncState = JSON.parse(fs.readFileSync(".atproto-sync.json", "utf-8"));
  documentUri = syncState.posts[post]?.documentUri;
} catch {
  // No sync state yet
}

const bskyPostUri = entry.data.bskyPostUri;
const pubDate = new Date(entry.data.pubDate);
const formattedDate = pubDate.toLocaleDateString("en-GB", {
  year: "numeric",
  month: "long",
  day: "numeric",
  weekday: "long",
});
---

<style>
  h1 {
    color: hsl(155, 43%, 18%);
    margin-bottom: 0;
  }

  .date {
    margin-top: 0;
    color: #74c69d;
    font-size: 0.9rem;
  }

  article :global(h2) {
    color: hsl(153, 40%, 30%);
  }

  article :global(p) {
    font-size: 1.1rem;
  }

  article :global(img) {
    max-width: 100%;
    height: auto;
  }
</style>

<SiteLayout title={entry.data.title} description={entry.data.description} documentUri={documentUri}>
  <h1>{entry.data.title}</h1>
  <p class="date">{formattedDate}</p>
  <article>
    <Content />
  </article>
  {bskyPostUri && <Comments bskyPostUri={bskyPostUri} />}
</SiteLayout>
