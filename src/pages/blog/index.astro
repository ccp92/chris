---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
const posts = await getCollection("blog");
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const groupedPosts = new Map<string, typeof posts>();
for (const post of posts) {
  const date = new Date(post.data.pubDate);
  const monthKey = date.toLocaleDateString("en-GB", {
    year: "numeric",
    month: "long",
  });

  if (!groupedPosts.has(monthKey)) {
    groupedPosts.set(monthKey, []);
  }

  groupedPosts.get(monthKey)!.push(post);
}

const title = "Blog";
---

<style>
  h1 {
    color: hsl(155, 43%, 18%);
    margin-bottom: 0;
  }

  h2 {
    color: hsl(153, 40%, 30%);
  }

  .date {
    color: hsl(0, 0%, 0%, 0.6);
  }
</style>

<SiteLayout title={title}>
  <h1>Blog Posts</h1>
  {
    Array.from(groupedPosts.entries()).map(([month, monthPosts]) => (
      <section>
        <h2>{month}</h2>
        <ul>
          {monthPosts.map((post) => (
            <li>
              <span class="date">
                {new Date(post.data.pubDate).toLocaleDateString("en-GB")}
                {" - "}
              </span>
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</SiteLayout>
