---
import SiteLayout from "../layouts/SiteLayout.astro";
import { Image } from "astro:assets";
import profile from "../images/profile.png";

const title = "Home";
const description =
  "Portfolio site of Chris Parsons (Christopher Parsons), a software engineer working in the United Kingdom.";
const startWork = new Date(2018, 7);
const currentDate = new Date();
const experienceInYears = Math.floor(
  (currentDate.getTime() - startWork.getTime()) / (1000 * 60 * 60 * 24 * 365),
);
---

<style>
  .container {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1rem;
  }

  .profileImage {
    border-radius: 50%;
    height: 3rem;
    width: 3rem;
    border: 3px solid #066e7e;
  }
  p {
    font-size: 1.3rem;
  }
</style>

<SiteLayout title={title} description={description}>
  <div class="container">
    <Image
      src={profile}
      alt="Chris Parsons"
      class="profileImage"
      loading="eager"
    />
    <h1>Chris Parsons</h1>
  </div>
  <p>
    Hey there, I'm Chris, a full-stack software engineer working in London with {
      experienceInYears
    }+ years of experience. Currently working at <a
      href="https://stotles.com"
      target="_blank"
      rel="noopener noreferrer">Stotles</a
    >, helping to build a platform for companies to manage their public sector
    procurement flows.
  </p>
  <p>
    Across my time in software engineering, I have had a large focus on the
    public sector and public sector adjacent companies.
  </p>
  <p>
    Take a look at <a href="/work">what I've been up to</a>.
  </p>
</SiteLayout>
