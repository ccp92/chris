---
import { Font } from "astro:assets";
import SiteLayout from "../layouts/SiteLayout.astro";

const title = "Home";
const description =
  "Portfolio site of Chris Parsons (Christopher Parsons), a fullstack software engineer working in Lodnon, in the United Kingdom.";

// TODO: Bring this back when adding below the fold content
// const startWork = new Date(2018, 7);
// const currentDate = new Date();
// const experienceInYears = Math.floor(
//   (currentDate.getTime() - startWork.getTime()) / (1000 * 60 * 60 * 24 * 365),
// );
---

<style>
  .container {
    display: flex;
    flex-direction: column;
    gap: 48px;
    justify-content: flex-end;
    flex: 1;
  }

  .info {
    display: flex;
    gap: 24px;
    container-type: inline-size;

    .content {
      flex: 1;
      display: flex;
      flex-direction: column-reverse;

      p {
        font-size: 1.5rem;
        max-width: 60vw;
      }
    }

    h1 {
      font-family: var(--font-open-sans-display);
      color: white;
      display: flex;
      flex-direction: column;
      margin-top: 0;
      margin-bottom: 0;
      font-size: 26.7cqi;
      font-weight: normal;
      line-height: 0.85;
      overflow: clip;

      @media (--md) {
        display: block;
        font-size: 15.68cqi;
      }
    }
  }
</style>

<SiteLayout title={title} description={description} fullWidth>
  <Font slot="head" cssVariable="--font-open-sans-display" preload />
  <section class="container">
    <header class="info">
      <div class="content">
        <h1>
          <span class="first-name">Chris</span>{" "}
          <span class="surname">Parsons</span>
        </h1>
        <p>
          Hey there! I'm a Fullstack Software Engineer based in London, working
          to build Product focussed applications that solve real problems.
        </p>
      </div>
    </header>

    <!-- <div class="intro-text">
      <p>
        Hey there! I'm Chris, a full-stack software engineer working in London
        with {experienceInYears} years of experience. Currently working at{" "}
        <a
          href="https://stotles.com"
