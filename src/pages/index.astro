---
import SiteLayout from "../layouts/SiteLayout.astro";
import { Image } from "astro:assets";
import profile from "../images/profile.jpg";
import headshot from "../images/headshot.jpeg";

const title = "Home";
const description =
  "Portfolio site of Chris Parsons (Christopher Parsons), a fullstack software engineer working in Lodnon, in the United Kingdom.";
const startWork = new Date(2018, 7);
const currentDate = new Date();
const experienceInYears = Math.floor(
  (currentDate.getTime() - startWork.getTime()) / (1000 * 60 * 60 * 24 * 365),
);
---

<style>
  p {
    font-size: 16px;
  }

  .container {
    display: flex;
    flex-direction: column;
    gap: 48px;
    align-items: flex-start;
  }

  .info {
    display: flex;
    gap: 24px;
    padding-top: 48px;

    h1 {
      color: hsl(153 39% 25%);
      font-size: 24px;
    }

    .subtitle {
      font-size: 16px;
      margin-top: 0;
      color: hsl(153 39% 65%);
      font-weight: normal;
    }

    .profile-icon {
      max-height: 120px;
      max-width: 120px;
      object-fit: cover;
      border-radius: 50%;
    }

    .description {
      display: flex;
      flex-direction: column;
    }
  }
</style>

<SiteLayout title={title} description={description}>
  <section class="container">
    <header class="info">
      <Image
        src={headshot}
        alt="A studio headshot of Chris Parsons, a person with short, styled brown hair and blue eyes, smiling gently at the camera. They are wearing a white, short-sleeved button-down shirt featuring a bold geometric pattern in shades of blue, pink, and lavender. The background is a clean, minimalist split of off-white on top and a soft, muted sage green on the bottom."
        class="profile-icon"
        loading="eager"
      />
      <div class="description">
        <h1>Chris Parsons</h1>
        <p class="subtitle">Fullstack Software Engineer</p>
      </div>
    </header>

    <div class="intro-text">
      <p>
        Hey there! I'm Chris, a full-stack software engineer working in London
        with {experienceInYears}+ years of experience. Currently working at <a
          href="https://stotles.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="External link to Stotles' homepage">Stotles</a
        >, helping to build a platform for companies to manage their public
        sector procurement flows.
      </p>
      <p>
        Across my time in software engineering, I have had a large focus on the
        public sector and public sector adjacent companies.
      </p>
      <p>
        Take a look at <a href="/work">what I've been up to</a>.
      </p>
    </div>
  </section>
</SiteLayout>
