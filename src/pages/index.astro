---
import SiteLayout from "../layouts/SiteLayout.astro";
import { Image } from "astro:assets";
import profile from "../images/profile.jpg";

const title = "Home";
const description =
  "Portfolio site of Chris Parsons (Christopher Parsons), a software engineer working in the United Kingdom.";
const startWork = new Date(2018, 7);
const currentDate = new Date();
const experienceInYears = Math.floor(
  (currentDate.getTime() - startWork.getTime()) / (1000 * 60 * 60 * 24 * 365),
);
---

<style>
  p {
    font-size: 1.3rem;
  }

  .intro {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1rem;
  }

  .intro-text {
    flex: 2;
  }

  .profile-picture {
    flex: 1;
    height: 16rem;
    width: auto;
    object-fit: cover;
    border-radius: 1rem;
    margin-top: 1rem;
  }

  @media (max-width: 1000px) {
    .intro {
      flex-direction: column-reverse;
      align-items: center;
    }

    .intro-text {
      flex: none;
      width: 100%;
    }

    .profile-picture {
      flex: none;
    }
  }
</style>

<SiteLayout title={title} description={description}>
  <div class="intro">
    <div class="intro-text">
      <p>
        Hey there, I'm Chris, a full-stack software engineer working in London
        with {experienceInYears}+ years of experience. Currently working at <a
          href="https://stotles.com"
          target="_blank"
          rel="noopener noreferrer">Stotles</a
        >, helping to build a platform for companies to manage their public
        sector procurement flows.
      </p>
      <p>
        Across my time in software engineering, I have had a large focus on the
        public sector and public sector adjacent companies.
      </p>
      <p>
        Take a look at <a href="/work">what I've been up to</a>.
      </p>
    </div>
    <Image
      src={profile}
      alt="Chris Parsons taking a selfie in a mirrored lift"
      class="profile-picture"
      loading="eager"
    />
  </div>
</SiteLayout>
