---
interface Props {
  title: string;
  description?: string;
  documentUri?: string;
  fullWidth?: boolean;
}

const { title, description, documentUri, fullWidth } = Astro.props;

import { Font } from "astro:assets";
---

<style is:global>
  body {
    font-family: var(--font-open-sans);
    background-color: #182f99;
    /*Adds the blueprint hatch effect*/
    background-image:
      linear-gradient(rgba(220, 235, 255, 0.25) 1px, transparent 1px),
      linear-gradient(90deg, rgba(220, 235, 255, 0.25) 1px, transparent 1px),
      linear-gradient(rgba(220, 235, 255, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(220, 235, 255, 0.1) 1px, transparent 1px);
    background-size:
      100px 100px,
      100px 100px,
      20px 20px,
      20px 20px;
    background-position: -1px -1px;
    background-attachment: fixed;
    color: white;
    margin: 0;
  }

  main {
    padding: 1rem;
    padding-top: 0;
    width: 100%;
    /*70ch text column plus the 1rem padding either side*/
    max-width: calc(70ch + 2rem);
    box-sizing: border-box;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  img {
    border: 10px solid transparent;
    border-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='30' height='30' viewBox='0 0 30 30'><path fill='none' stroke='white' stroke-width='1.5' d='M10,3 C12.5,3 12.5,7 15,7 S17.5,3 20,3 A7,7 0 0 1 27,10 C27,12.5 23,12.5 23,15 S27,17.5 27,20 A7,7 0 0 1 20,27 C17.5,27 17.5,23 15,23 S12.5,27 10,27 A7,7 0 0 1 3,20 C3,17.5 7,17.5 7,15 S3,12.5 3,10 A7,7 0 0 1 10,3 Z'/></svg>")
      10 round;
    padding: 2px;
  }

  p {
    font-size: 1.5rem;
  }

  a {
    text-decoration: underline;
    color: white;
    text-decoration-color: white;
  }

  .page {
    min-height: 100dvh;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .page--full main {
    max-width: none;
  }

  .nav {
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 12px;
    width: 100%;
    padding: 1rem;
    box-sizing: border-box;
    font-size: 1.5rem;

    a {
      text-decoration: underline;
      text-decoration-style: wavy;
      text-decoration-skip-ink: auto;
      text-decoration-thickness: 1px;
    }
  }
</style>

<html lang="en-gb">
  <head>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font cssVariable="--font-open-sans" preload />
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <title>Chris Parsons: {title}</title>
    <meta property="og:title" content={`Chris Parsons: ${title}`} />
    {documentUri && <link rel="site.standard.document" href={documentUri} />}
    <script
      defer
      data-domain="chrisparsons.dev"
      data-api="/api/v1/telemetry"
      src="/assets/js/main.js"
    ></script>
    <link rel="me" href="https://sifa.id/p/chrisparsons.dev" />
    <link
      rel="webmention"
      href="https://webmention.io/chrisparsons.dev/webmention"
    />
    <slot name="head" />
  </head>

  <body>
    <div class:list={["page", { "page--full": fullWidth }]}>
      <nav class="nav" aria-label="Primary">
        <a href="/">home</a>
        <a href="/work">work</a>
        <a href="/blog">blog</a>
        <a href="/now">now</a>
      </nav>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
