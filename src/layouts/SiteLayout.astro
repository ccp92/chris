---
interface Props {
  title: string;
  description?: string;
  documentUri?: string;
}

const { title, description, documentUri } = Astro.props;

import { Font } from "astro:assets";
---

<style is:global>
  body {
    font-family: var(--font-open-sans);
    background-color: #182f99;
    /*Adds the blueprint hatch effect*/
    background-image:
      linear-gradient(rgba(220, 235, 255, 0.25) 1px, transparent 1px),
      linear-gradient(90deg, rgba(220, 235, 255, 0.25) 1px, transparent 1px),
      linear-gradient(rgba(220, 235, 255, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(220, 235, 255, 0.1) 1px, transparent 1px);
    background-size:
      100px 100px,
      100px 100px,
      20px 20px,
      20px 20px;
    background-position: -1px -1px;
    background-attachment: fixed;
    color: white;
    margin: 0;
  }

  main {
    padding: 1rem;
    padding-top: 0;
    width: 100%;
    box-sizing: border-box;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  a {
    text-decoration: underline;
    color: white;
    text-decoration-color: white;
  }

  .page {
    min-height: 100dvh;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .nav {
    display: flex;
    flex-direction: row;
    gap: 12px;
    width: 100%;
    padding: 1rem;
    box-sizing: border-box;
    font-size: 1.5rem;

    a {
      text-decoration: underline;
      text-decoration-style: wavy;
      text-decoration-skip-ink: auto;
      text-decoration-thickness: 1px;
    }
  }
</style>

<html lang="en-gb">
  <head>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font cssVariable="--font-open-sans" preload />
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <title>Chris Parsons: {title}</title>
    <meta property="og:title" content={`Chris Parsons: ${title}`} />
    {documentUri && <link rel="site.standard.document" href={documentUri} />}
    <script
      defer
      data-domain="chrisparsons.dev"
      data-api="/api/v1/telemetry"
      src="/assets/js/main.js"
    ></script>
    <link rel="me" href="https://sifa.id/p/chrisparsons.dev" />
    <link
      rel="webmention"
      href="https://webmention.io/chrisparsons.dev/webmention"
    />
    <slot name="head" />
  </head>

  <body>
    <div class="page">
      <nav class="nav" aria-label="Primary">
        <a href="/">home</a>
        <a href="/work">work</a>
        <a href="/blog">blog</a>
        <a href="/now">now</a>
      </nav>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
